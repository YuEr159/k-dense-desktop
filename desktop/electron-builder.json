{
  "appId": "ai.kdense.kady.desktop",
  "productName": "Kady",
  "copyright": "MIT licensed. Based on K-Dense BYOK by K-Dense Inc.",
  "directories": {
    "output": "../dist",
    "buildResources": "resources"
  },
  "icon": "icon.ico",
  "files": [
    "main.mjs",
    "service-manager.mjs",
    "preflight.mjs",
    "runtime-env.mjs",
    "shell-i18n.mjs",
    "shell-log.mjs",
    "page-locale.mjs",
    "splash-progress.mjs",
    "startup-readiness.mjs",
    "window-state.mjs",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "build/runtime",
      "to": "runtime"
    },
    {
      "from": "build/externals",
      "to": "externals"
    },
    {
      "from": "resources/icon.png",
      "to": "icon.png"
    },
    {
      "from": "../LICENSE",
      "to": "LICENSE"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Kady-${version}-${arch}-Portable.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "differentialPackage": false,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "artifactName": "Kady-${version}-${arch}-Setup.${ext}"
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.productivity",
    "icon": "resources/icon.icns",
    "artifactName": "Kady-${version}-mac-${arch}.${ext}",
    "hardenedRuntime": true,
    "entitlements": "resources/entitlements.mac.plist",
    "entitlementsInherit": "resources/entitlements.mac.plist",
    "minimumSystemVersion": "12.0",
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": ["iconTemplate*.png"]
      }
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Science"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "**/node_modules/**"
  ],
  "beforePack": "scripts/before-pack.mjs"
}
